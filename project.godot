; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Blessed"
config/description="Sandbox de sobrevivência slice-of-life em 1ª pessoa: mundo procedural anime, dias serenos e noites que se lembram de ti."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.047, 0.07, 1)
boot_splash/show_image=false

[autoload]

Bus="*res://scripts/core/bus.gd"
Loc="*res://scripts/core/loc.gd"
Db="*res://scripts/core/db.gd"
Sfx="*res://scripts/core/sfx.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/screen_space_roughness_filter/enabled=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.066, 1)
lights_and_shadows/directional_shadow/size=4096
global_illumination/voxel_gi/quality=0
