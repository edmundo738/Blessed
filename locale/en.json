  "npc.elder.name": "Gran Miren",
  "npc.elder.greet_first": "Well now… another one fell out of the sky. Are you in one piece?",
  "npc.elder.greet": "Still here. Good sign.",
  "npc.elder.night": "Get near the fire. The night here has teeth.",
  "npc.elder.wood": "Wood first, questions later.",
  "npc.elder.thanks": "You owed me nothing. Thank you.",
  "npc.elder.topic_night": "What is out there at night?",
  "npc.elder.topic_world": "What is this place?",
  "npc.elder.topic_blessed": "They told me I am blessed.",
  "npc.elder.topic_bye": "See you.",
  "npc.elder.a_night": "We call them the Hungry. Light bothers them. Fire drives them off. Running sometimes works.",
  "npc.elder.a_world": "Nobody knows its name. Some call it the Blessing, others the Calling. We all fell asleep somewhere else.",
  "npc.elder.a_blessed": "We all are. That is why the world answers you. It is also why they want you.",
  "npc.elder.a_bye": "Go on. And shut the door.",

